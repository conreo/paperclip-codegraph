{
  "name": "paperclip-codegraph",
  "version": "0.9.9",
  "type": "module",
  "description": "CodeGraph code-intelligence MCP tools for Paperclip agents, with per-company, per-project and per-agent governance.",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "e2e:isolation": "node ./scripts/e2e-isolation.mjs",
    "provision:native-mcp": "node ./scripts/provision-native-mcp.mjs",
    "fixture:mcp": "node ./tests/fixtures/fake-codegraph-mcp.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run verify",
    "test:live": "CODEGRAPH_TEST_PROJECT=${CODEGRAPH_TEST_PROJECT:-$PWD/../pos} vitest run --config ./vitest.config.ts tests/graph-reader-live.spec.ts tests/reader-shape.spec.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "paperclipai",
    "codegraph",
    "mcp",
    "model-context-protocol",
    "code-intelligence",
    "knowledge-graph",
    "code-graph",
    "governance",
    "multi-tenant",
    "ai-agents"
  ],
  "author": "conreo",
  "license": "MIT",
  "homepage": "https://github.com/conreo/paperclip-codegraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conreo/paperclip-codegraph.git"
  },
  "bugs": {
    "url": "https://github.com/conreo/paperclip-codegraph/issues"
  },
  "files": [
    "dist",
    "docs/ASSUMPTIONS.md",
    "docs/ARCHITECTURE.md",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": ">=2026.817.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@paperclipai/plugin-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.817.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
